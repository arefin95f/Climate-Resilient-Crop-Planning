# Copy to secrets.toml on Streamlit Cloud only if the live app
# should use a hosted MySQL server. Leave these unset to serve the
# datasets and models already stored in this project.

# MYSQL_HOST = "your-mysql-host"
# MYSQL_PORT = "3306"
# MYSQL_USER = "agrisight"
# MYSQL_PASSWORD = "your-password"
# MYSQL_DATABASE = "agrisight_bd"
